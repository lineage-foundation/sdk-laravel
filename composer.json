{
    "name": "lineage/laravel",
    "description": "Laravel wrapper for the Lineage blockchain SDK",
    "type": "library",
    "version": "0.4.0",
    "license": "MIT",
    "keywords": [
        "blockchain",
        "lineage",
        "laravel"
    ],
    "autoload": {
        "psr-4": {
            "Lineage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lineage\\Tests\\": "tests/",
            "App\\": "tests/Support/App/"
        }
    },
    "authors": [
        {
            "name": "Lineage Foundation",
            "email": "info@lineage.foundation",
            "role": "developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "lineage/php": "^0.4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lineage\\Providers\\LineageServiceProvider"
            ],
            "aliases": {
                "Lineage": "Lineage\\Facades\\LineageFacade"
            }
        }
    }
}
